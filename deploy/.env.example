# === Domaine (un enregistrement DNS A doit pointer vers l'IP du VPS) ===
DOMAIN=budget.mondomaine.fr
ACME_EMAIL=moi@exemple.fr

# === Premier admin (créé au 1er démarrage si la base est vide) ===
# Une fois connecté, vide ADMIN_PASSWORD et relance : il ne sert plus.
ADMIN_USERNAME=nathan
ADMIN_PASSWORD=

# === Backups ===
# Chiffre le backup mensuel (GPG AES256). Sans passphrase → archive en clair.
BACKUP_PASSPHRASE=

# === IA (optionnel) ===
# Laisser vide pour configurer depuis l'app (Réglages → Provider LLM).
# Une valeur ici prime sur les réglages in-app.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_RPD_LIMIT=200

# === Agent (Hermes) / n8n ===
# Active /api/agent/*. Générer avec : openssl rand -hex 32
# Ce token agit pour n'importe quel utilisateur lié : à garder aussi secret qu'un mot de passe admin.
AGENT_API_TOKEN=

LOG_LEVEL=info
TZ=Europe/Paris
