# Image autonome (sans Home Assistant) pour un VPS : FastAPI + SPA buildée.
# Le TLS est géré par Caddy devant (cf deploy/docker-compose.yml).

FROM node:20-alpine AS frontend-builder
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends gnupg tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1000 --home-dir /app budget

WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/
COPY config.yaml /app/config.yaml
COPY --from=frontend-builder /build/dist /app/static

RUN mkdir -p /data /backup && chown budget:budget /data /backup

USER budget

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AUTH_MODE=standalone \
    DATA_DIR=/data \
    STATIC_DIR=/app/static \
    DATABASE_URL="sqlite:////data/db/budget.db?check_same_thread=False" \
    TZ=Europe/Paris

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health')" || exit 1

# --proxy-headers : IP réelle du client (rate-limit login) depuis Caddy.
# "*" est sûr ici car le port 8000 n'est joignable que depuis le réseau docker.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
